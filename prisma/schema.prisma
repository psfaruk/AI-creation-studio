// ============================================================
// Agentic AI Creative Studio — Prisma schema (SQLite)
// পার্ট ১: Agentic Chat (Conversation, Message, AgentRun,
//          AgentStep, ToolCall, Artifact)
// পার্ট ২: Creative Studio (Production, ProductionStep,
//          ModelEntry — মাস্টার প্ল্যান §৭,৮,৯ অনুযায়ী)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id          String        @id @default(cuid())
  title       String        @default("নতুন কথোপকথন")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    Message[]
  runs        AgentRun[]
  artifacts   Artifact[]
  productions Production[]
  characters  Character[]
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String // 'user' | 'assistant'
  content         String
  runId           String?      @unique // assistant message ↔ agent run (1:1)
  productionId    String? // এই বার্তায় দেখানো production কার্ড
  attachmentsJson String? // JSON array of AttachmentView (user uploads)
  createdAt       DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model AgentRun {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         String       @default("running") // running | completed | failed | interrupted
  error          String?
  // অডিট-রিপোর্ট §১-B: স্পষ্ট এরর-শ্রেণি (rate_limited | provider_error |
  // invalid_key | missing_key | invalid_model | timeout | malformed_tool_json |
  // unknown_tool | tool_error | ffmpeg_error | storage_error | max_steps | aborted | unknown)
  errorCategory  String?
  // রান কেন শেষ হলো (final_answer | max_steps | provider_error | rate_limit |
  // invalid_tool_call | timeout | cancelled)
  endReason      String?
  // শেষ LLM-কলের ডিস্ক-ক্যাশ অবস্থা (hit | miss | bypass)
  cacheStatus    String?
  // ব্যবহারকারীর অনুরোধকৃত মোড (normal | chat_only | diagnostic)
  requestedMode  String?
  stepCount      Int          @default(0)
  toolCallCount  Int          @default(0)
  durationMs     Int?
  // (অডিট §B) প্রথম-টোকেন/প্রথম-LLM-উত্তরের সময় (ms) — লেটেন্সি-যাচাই
  firstTokenMs   Int?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  model          String? // ব্যবহারকারীর অনুরোধকৃত চ্যাট-মডেল (null = SDK ডিফল্ট)
  usedModel      String? // প্রকৃতপক্ষে ব্যবহৃত মডেল (ফলব্যাক হলে আলাদা হতে পারে)
  steps          AgentStep[]
  toolCalls      ToolCall[]
  artifacts      Artifact[]

  @@index([conversationId])
}

model AgentStep {
  id          String   @id @default(cuid())
  runId       String
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq         Int
  kind        String // 'llm_decision' | 'tool_execution' | 'final_answer'
  name        String?
  payloadJson String?
  createdAt   DateTime @default(now())

  @@index([runId, seq])
}

model ToolCall {
  id            String    @id @default(cuid())
  runId         String
  run           AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  tool          String
  argsJson      String
  inputSummary  String // human-readable (Bengali) argument summary for UI
  status        String // running | done | failed
  outputSummary String? // human-readable result summary for UI
  resultJson    String? // compact JSON result fed back to the LLM
  error         String?
  durationMs    Int?
  createdAt     DateTime  @default(now())

  @@index([runId, createdAt])
}

model Artifact {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runId          String?
  run            AgentRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  productionId   String? // কোন production-এর ফলাফল
  production     Production?  @relation(fields: [productionId], references: [id], onDelete: SetNull)
  messageId      String? // set for user uploads; tool artifacts map via runId
  origin         String       @default("tool") // 'tool' | 'user_upload' | 'production'
  kind           String // 'image' | 'audio' | 'video' | 'text'
  mimeType       String
  fileName       String
  size           Int          @default(0)
  storagePath    String? // local file path (tool/user generated)
  sourceUrl      String? // external URL (image-search results)
  metaJson       String? // মিডিয়া মেটাডেটা (দৈর্ঘ্য/মাত্রা/কোডেক ইত্যাদি)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([runId])
  @@index([productionId])
}

// ------------------------------------------------------------
// Creative Studio — Production (Creative Job) system
// ------------------------------------------------------------

model Production {
  id                  String          @id @default(cuid())
  conversationId      String
  conversation        Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type                String // 'image' | 'audio' | 'motion_video' | 'music_video' | 'short_film'
  title               String
  status              String          @default("awaiting_confirmation") // awaiting_confirmation | queued | running | validating | completed | failed | partial | cancelled | cancelling
  specJson            String // CreativeJobSpec (typed, §১৫)
  progress            Int             @default(0) // 0-100
  currentStepKey      String?
  error               String?
  resultJson          String? // quality report, shot summaries, notes
  parentProductionId  String? // সংশোধন চেইন (revision)
  parent              Production?     @relation("Revisions", fields: [parentProductionId], references: [id], onDelete: SetNull)
  revisions           Production[]    @relation("Revisions")
  createdAt           DateTime        @default(now())
  // (D-8/B6) ব্যবহারকারীর নিশ্চিতকরণের মুহূর্ত — confirm রাউট লেখে।
  // null = ঐতিহাসিক সারি (কলাম-যোগের আগে) বা অ-নিশ্চিত — মেট্রিকসে
  // সৎ-null (confirmationHoldMs=null), কখনো কাল্পনিক নয়।
  confirmedAt         DateTime?
  startedAt           DateTime?
  finishedAt          DateTime?
  steps               ProductionStep[]
  artifacts           Artifact[]

  @@index([conversationId, createdAt])
  @@index([status])
}

model ProductionStep {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  seq          Int
  key          String // pipeline ধাপের নাম (script_writer ইত্যাদি)
  title        String // বাংলা শিরোনাম
  status       String     @default("pending") // pending | running | done | failed | skipped
  detail       String? // মাঝপথের বার্তা ("৩/৬ শট তৈরি")
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([productionId, seq])
}

// ------------------------------------------------------------
// Character Bible — নতুন মাস্টার প্ল্যান §৭.২
// স্থায়ী character ID + রেফারেন্স পোর্ট্রেট — একই কথোপকথনের
// বিভিন্ন প্রোডাকশনে চরিত্রের পরিচয় ধরে রাখতে ব্যবহৃত।
// ------------------------------------------------------------

model Character {
  id                 String       @id @default(cuid())
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  name               String
  role               String       @default("প্রধান চরিত্র") // ভূমিকা
  description        String // ব্যক্তিত্ব/পরিচয়
  appearanceJson     String? // বয়স/চুল/পোশাক ইত্যাদি
  language           String       @default("bn") // সংলাপের ভাষা
  voice              String       @default("jam") // TTS কণ্ঠ
  portraitArtifactId String? // রেফারেন্স পোর্ট্রেট (artifact)
  continuityNotesJson String? // দৃশ্য-অনুযায়ী ধারাবাহিকতা-নোট
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([conversationId, name])
}

// ------------------------------------------------------------
// Model & License Registry (মাস্টার প্ল্যান §৮)
// ------------------------------------------------------------

model ModelEntry {
  id                String    @id @default(cuid())
  key               String    @unique
  name              String
  category          String // llm | image | audio | video | utility | infrastructure
  provider          String
  license           String
  licenseUrl        String?
  commercialUse     String // allowed | restricted | unknown | not_applicable
  status            String // enabled | experimental | blocked | planned (সামগ্রিক; নিচের ৪টি আলাদা মাত্রা)
  // ---- নতুন মাস্টার প্ল্যান §২: ৪টি আলাদা স্ট্যাটাস-মাত্রা ----
  licenseStatus     String? // allowed | allowed_noncommercial | allowed_with_conditions | provider_api_only | needs_review | blocked_by_license
  providerStatus    String? // exposed_by_sdk | not_exposed_by_sdk | unknown
  integrationStatus String? // integrated | partial | not_integrated
  runtimeStatus     String? // healthy | degraded | temporarily_unavailable | unavailable_hardware | not_applicable
  qualityStatus     String? // নতুন পরিকল্পনা §১: quality_not_verified | quality_machine_checked | quality_human_verified | quality_not_applicable
  apiEndpoint       String? // যেমন: zai.video.generations.create
  apiModelId        String? // যেমন: cogvideox-3
  lastTestedAt      DateTime? // শেষ সফল/ব্যর্থ বাস্তব API-পরীক্ষার সময়
  lastTestNote      String? // পরীক্ষার ফলাফল-সারাংশ
  errorReason       String? // অনুপলব্ধ হলে প্রকৃত কারণ (লাইসেন্স/প্রোভাইডার/হার্ডওয়্যার/ইন্টিগ্রেশন)
  toolsJson         String? // এই মডেলটি কোন কোন টুলে ব্যবহৃত
  capabilitiesJson  String // সমর্থিত মাত্রা/সময়/ফরম্যাট ইত্যাদি
  hardwareNotes     String?
  notes             String?
  verifiedAt        DateTime?
  sortOrder         Int       @default(100)
  createdAt         DateTime  @default(now())
}
