# ============================================================
# .dockerignore — বিল্ড-কনটেক্সট ছোট, পুনরাবৃত্তিযোগ্য ও নিরাপদ রাখতে।
# সবচেয়ে গুরুত্বপূর্ণ নিয়ম: কোনো গোপন মান/রানটাইম-ডেটা কখনো ইমেজে
# ঢুকতে পারবে না — .env*, .z-ai-config*, storage/, db/ (git-এ যেমন
# নেই, ইমেজেও নেই)।
# ============================================================

# --- গোপন ও লোকাল কনফিগ (কখনোই ইমেজে নয়) ---
.env
.env.*
!.env.example
.z-ai-config
.z-ai-config.*
.claude
credentials*.json
*.pem

# --- VCS / CI ---
.git
.github
.gitignore

# --- নির্ভরতা ও বিল্ড-আর্টিফ্যাক্ট (ইমেজের ভেতরে নতুন করে তৈরি হয়) ---
node_modules
.next
out
build
coverage
*.tsbuildinfo

# --- রানটাইম ডেটা (Railway-তে ভলিউম-ব্যাকড) ---
storage
db
upload
*.log
dev.log
server.log
*.pid
.zscripts

# --- ডকুমেন্ট ও অডিট-এভিডেন্স (~২৩ MB বাইনারি সহ; রানটাইমে অপ্রয়োজনীয়) ---
docs

# --- টুলিং-জাঙ্ক / স্যান্ডবক্স-স্ক্র্যাচ ---
tool-results
tmp-*
/tmp-*
mixrepro-*
model-test
skills
prompt
test
skill-*
