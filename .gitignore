# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example টেমপ্লেটটি রিপোতে থাকবে (শুধু নিরাপদ প্লেসহোল্ডার — আসল মান কখনো নয়)
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
# local-* নিয়মটি সরানো হলো — এটি src/lib/agent/local-frames.ts-কে নীরবে
# ignore করত, তাই ফাইলটি কখনো git-এ যেত না এবং প্রতি রিসেটে build ভেঙে পড়ত
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# runtime process files
.zscripts/dev.pid
*.pid

# Skills directory
/skills/
# runtime junk (Deep-Report cleanup) — tool-read cache, repro dumps, tmp diagnostics
/tool-results/
/tmp-*/
mixrepro-*
/model-test/
storage/logs/

# runtime storage — LLM cache, provider keys, generated media (security audit fix)
# storage/-এর ভেতরে সবকিছুই রানটাইম ডেটা: llm-chat (১২ঘ LLM ক্যাশ — প্রম্পট লিক
# হতে পারে), tts-cache, artifacts/, productions/, এবং গোপন provider-keys.json +
# custom-providers.json (এই দুটি পুরনো আলাদা-আলাদা নিয়ম নতুন blanket নিয়মে অন্তর্ভুক্ত)
/storage/
# user uploads & tool junk
/upload/

# runtime SQLite database (audit fix — never commit runtime DB)
db/*.db
db/*.db-journal
